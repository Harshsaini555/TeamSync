PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/teamsync

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_access_token_key_32bytes_min
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_32bytes_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3000

# Email SMTP (Nodemailer for verification & password reset)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="TeamSync Security <no-reply@teamsync.app>"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
